# Copy to config.env and edit. Sourced by make/scripts (KEY=value, no spaces).
# Target under test. Use --network host compatible URLs, e.g. http://127.0.0.1:8080
TARGET_URL=http://127.0.0.1:8080
RUN_NAME=myapp
# OUT_DIR is set by `make new-run` (reports/<RUN_NAME>/<run-id>/). Override if needed.
OUT_DIR=
# Port for ZAP's own proxy (must NOT equal the target port when target is loopback).
ZAP_PROXY_PORT=8090

# --- Authenticated scans (AUTH_MODE=none|json) ---
AUTH_MODE=none
# JSON login: POST body with {%username%} {%password%} placeholders.
LOGIN_URL=http://127.0.0.1:8080/api/login
LOGIN_BODY={"name":"{%username%}","password":"{%password%}"}
AUTH_USER=zapuser
AUTH_PASS=changeme
# Verification: GET this URL; logged in iff LOGGED_IN_REGEX matches.
VERIFY_URL=http://127.0.0.1:8080/api/me
LOGGED_IN_REGEX="session"
LOGGED_OUT_REGEX=not logged in
# Pipe-separated path prefixes excluded from spider+active (e.g. logout endpoints).
EXCLUDE_PATHS=/api/logout|/api/logout-all

# --- Nuclei ---
NUCLEI_TEMPLATES=http/exposures/,http/misconfiguration/,http/vulnerabilities/other/
NUCLEI_SEVERITY=medium,high,critical,unknown
NUCLEI_RATE_LIMIT=50

# --- Playwright HAR capture (generic login flow) ---
LOGIN_BUTTON_TEXT="Log in"
LOGIN_USER=zapuser
LOGIN_PASS=changeme
# Extra pages to visit (space-separated) while recording, e.g. key app routes.
HAR_EXTRA_URLS=
# --- Generic XSS test ---
# CSS selector of the message composer; payloads are typed + Enter.
XSS_COMPOSER_SELECTOR=textarea
# Optional: file input selector + substring identifying served file links in sent messages.
XSS_FILE_INPUT=input[type="file"]
XSS_FILE_LINK_SUBSTR=/files/
